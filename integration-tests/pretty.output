  @db
  Scenario: A new worker account is created and stored                                                                                      # features/auth.feature:77
    Given the mock data is in place                                                                                                         # features/steps/given_steps.py:22
    When a client registers with name "Fresh Worker", email "fresh.worker@localhire.test", password "LocalHire1!" and role "LookingForWork" # features/steps/when_steps.py:96
    Then the response status code is 201                                                                                                    # features/steps/then_steps.py:43
    And the response field "token" is present                                                                                               # features/steps/then_steps.py:82
    And table "Users" has 15 rows                                                                                                           # features/steps/then_steps.py:267

  @db
  Scenario: Registering an email and role that already exist is refused                                                     # features/auth.feature:85
    Given the mock data is in place                                                                                         # features/steps/given_steps.py:22
    When a client registers with name "Copy Cat", email "employer@localhire.test", password "LocalHire1!" and role "Hiring" # features/steps/when_steps.py:96
    Then the response status code is 409                                                                                    # features/steps/then_steps.py:43
    And the response body contains the error "already exists"                                                               # features/steps/then_steps.py:194
    And table "Users" has 14 rows                                                                                           # features/steps/then_steps.py:267

